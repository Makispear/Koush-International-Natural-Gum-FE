{
    "rewrites": [
        {
            "source": "/products",
            "destination": "/products.html"
        },
        {
            "source": "/about",
            "destination": "/about.html"
        },
        {
            "source": "/contact",
            "destination": "/contact.html"
        },
        {
            "source": "/quote",
            "destination": "/quote.html"
        },
        {
